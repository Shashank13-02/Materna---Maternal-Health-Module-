# Backend environment variables — copy to .env and fill in values
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# OTP settings (mock in dev — real SMS gateway in prod)
OTP_EXPIRY_SECONDS=300
OTP_MOCK_MODE=true
OTP_MOCK_CODE=123456

# Webhook target (central risk platform)
CENTRAL_PLATFORM_WEBHOOK_URL=https://your-central-platform.example.com/api/webhooks/maternal
WEBHOOK_SECRET=change-this-webhook-secret

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
